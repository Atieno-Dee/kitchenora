# Copy to .env (local) or set as environment variables on your host. NEVER commit real values.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=your_consumer_key_here
DARAJA_CONSUMER_SECRET=your_consumer_secret_here
DARAJA_SHORTCODE=your_shortcode_here
DARAJA_PASSKEY=your_passkey_here
# Must be a public HTTPS URL, e.g. https://your-public-domain/api/mpesa/callback
DARAJA_CALLBACK_URL=https://your-public-domain/api/mpesa/callback
npm